{
  "uid": "foosball-device",
  "title": "Foosball — device",
  "tags": [
    "foosball"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-3d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(foosball_uptime_milliseconds, device_id)",
          "refId": "v"
        },
        "definition": "label_values(foosball_uptime_milliseconds, device_id)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "DEBUG,INFO,WARN,ERROR",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/foosball-fleet"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Battery",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_battery_voltage_volts{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3.45
              },
              {
                "color": "green",
                "value": 3.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last seen",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max_over_time(timestamp(foosball_uptime_milliseconds{device_id=\"$device\"})[14d:5m])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 95040.00000000001
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Wi-Fi RSSI",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_wifi_rssi_dBm{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -80
              },
              {
                "color": "green",
                "value": -70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Wake count since power-on",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_wakes_total{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Device",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (foosball_role, foosball_table_id, service_version) (last_over_time(foosball_uptime_milliseconds{device_id=\"$device\"}[14d]))",
          "legendFormat": "{{foosball_role}} · {{foosball_table_id}} · fw {{service_version}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Battery voltage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time(foosball_battery_voltage_volts{device_id=\"$device\"}[$__interval])",
          "legendFormat": "battery"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3.45
              },
              {
                "color": "green",
                "value": 3.6
              }
            ]
          },
          "min": 3.0,
          "max": 5.0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15m"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Wi-Fi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time(foosball_wifi_rssi_dBm{device_id=\"$device\"}[$__interval])",
          "legendFormat": "RSSI (dBm)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time(foosball_wifi_connect_time_milliseconds{device_id=\"$device\"}[$__interval])",
          "legendFormat": "connect time (ms)"
        }
      ],
      "description": "RSSI and association time of the session that ended at each point.",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "connect time (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "15m"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Problems per rolling 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(foosball_beam_rejected_blocks_total{device_id=\"$device\"}[1d]))",
          "legendFormat": "beam_rejected_blocks"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(foosball_beam_stuck_events_total{device_id=\"$device\"}[1d]))",
          "legendFormat": "beam_stuck_events"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(foosball_queue_dropped_total{device_id=\"$device\"}[1d]))",
          "legendFormat": "queue_dropped"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(foosball_wifi_retries_total{device_id=\"$device\"}[1d]))",
          "legendFormat": "wifi_retries"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(foosball_log_dropped_total{device_id=\"$device\"}[1d]))",
          "legendFormat": "log_dropped"
        }
      ],
      "description": "Counters are cumulative since power-on and exported per session; increase() over 24 h tolerates the gaps and battery swaps.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Boots by reset reason (time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (foosball_reset_reason) (count_over_time(foosball_reset_ratio{device_id=\"$device\"}[$__range]))",
          "legendFormat": "{{foosball_reset_reason}}",
          "instant": true
        }
      ],
      "description": "Metrics exports per reset reason. deepsleep = normal wake. panic / *wdt / brownout / other = a crash or a sagging battery.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Beam health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Worst state at the last report. low_margin: clean or realign the beam. ambient_high: shade the drawer. blocked: empty the drawer, then check the LED. sensor_dead: check the receiver (firmware/beam-health-firmware-2026-10-16.md §4).",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_beam_health_ratio{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ok",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "low_margin",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "ambient_high",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "blocked",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "sensor_dead",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Beam mode",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Active beam mode (server beam_mode; auto picks one of these).",
      "gridPos": {
        "x": 6,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_beam_mode_ratio{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "a",
                  "index": 0
                },
                "1": {
                  "text": "a_boost",
                  "index": 1
                },
                "2": {
                  "text": "b (daylight)",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Beam margin",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Lit margin of the active mode at the last check (×). low_margin below the server's beam_margin_min.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_beam_margin_ratio{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Ambient light",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "I_amb at the last check: receiver current with the LED off. Higher = more daylight in the drawer.",
      "gridPos": {
        "x": 18,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(foosball_beam_ambient_uA{device_id=\"$device\"}[14d])",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: µA",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Ambient light by hour of day",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "timeFrom": "24h",
      "interval": "1h",
      "maxDataPoints": 48,
      "description": "Highest ambient light (I_amb, LED off) per hour over the last 24 h, with earlier days laid over the same clock times. From the beam summary log record (every beam_report_s while awake), so hours with no play are empty. ambient_high starts above beam_ambient_max_pct of the mode's tolerance (firmware/beam-health-firmware-2026-10-16.md §4). Link: /d/foosball-device?var-device=<device_id>&viewPanel=panel-15",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "today",
          "expr": "max_over_time({service_instance_id=\"$device\"} | foosball_tag=\"beam\" |= \"summary\" | unwrap amb_na [1h]) by (device_id) / 1000"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "yesterday",
          "expr": "max_over_time({service_instance_id=\"$device\"} | foosball_tag=\"beam\" |= \"summary\" | unwrap amb_na [1h] offset 1d) by (device_id) / 1000"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "2 days ago",
          "expr": "max_over_time({service_instance_id=\"$device\"} | foosball_tag=\"beam\" |= \"summary\" | unwrap amb_na [1h] offset 2d) by (device_id) / 1000"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "7 days ago",
          "expr": "max_over_time({service_instance_id=\"$device\"} | foosball_tag=\"beam\" |= \"summary\" | unwrap amb_na [1h] offset 7d) by (device_id) / 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: µA",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "yesterday"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "2 days ago"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
