---
import { Play } from '@lucide/astro';
---

<span class="queue-up" aria-hidden="true"><Play size={24} /><span>Queue up</span></span>

<style>
  .queue-up {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 72px;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--primary-foreground);
    font: 500 20px/28px var(--font-sans);
  }
</style>
