    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3": "^7.9.0",
    "lucide-react": "1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
