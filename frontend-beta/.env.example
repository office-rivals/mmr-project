# Base URL of the .NET API. Server-only, read via process.env at run time.
API_BASE_PATH=http://localhost:8081

# The Clerk middleware supplies this public key to the browser during SSR.
# VITE_CLERK_PUBLISHABLE_KEY remains supported for existing local setups.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Clerk secret key. Server only — never VITE_-prefixed.
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# This app signs in at /login, not Clerk's default /sign-in.
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/sign-up

# Forwarded headers are ignored by default. Use loopback for a controlled
# same-host proxy, or provide the exact proxy IP addresses separated by commas.
TRUST_PROXY=false

# Public HTTPS origin behind a TLS-terminating proxy. Leave unset in local dev.
# APP_ORIGIN=https://beta.app.example.com

# Accept session tokens minted on either configured application origin.
# CLERK_AUTHORIZED_PARTIES=https://app.example.com,https://beta.app.example.com

# Grafana with the foosball devices' telemetry; links each goal counter's
# light-by-hour panel on the admin Hardware page. Unset hides the link.
# GRAFANA_URL=https://grafana.example.com
