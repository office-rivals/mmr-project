{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "basePath": "/api",
    "paths": {
        "/v1/mmr-calculation": {
            "post": {
                "description": "Submit two teams' details for MMR calculation",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Calculation"
                ],
                "summary": "Submit an MMR calculation request",
                "parameters": [
                    {
                        "description": "MMR Calculation Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/view.MMRCalculationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MMR calculation result",
                        "schema": {
                            "$ref": "#/definitions/view.MMRCalculationResponse"
                        }
                    }
                }
            }
        },
        "/v1/mmr-calculation/batch": {
            "post": {
                "description": "Submit multiple MMR calculation requests",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Calculation"
                ],
                "summary": "Submit multiple MMR calculation requests",
                "parameters": [
                    {
                        "description": "MMR Calculation Requests",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/view.MMRCalculationRequest"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MMR calculation results",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/view.MMRCalculationResponse"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "view.MMRCalculationPlayerRating": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "isPreviousSeasonRating": {
                    "type": "boolean"
                },
                "mu": {
                    "description": "Use pointers to represent nullable values",
                    "type": "number"
                },
                "sigma": {
                    "description": "Use pointers to represent nullable values",
                    "type": "number"
                }
            }
        },
        "view.MMRCalculationRequest": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRCalculationTeam"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRCalculationTeam"
                }
            }
        },
        "view.MMRCalculationResponse": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRTeamResult"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRTeamResult"
                }
            }
        },
        "view.MMRCalculationTeam": {
            "type": "object",
            "required": [
                "players",
                "score"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.MMRCalculationPlayerRating"
                    }
                },
                "score": {
                    "type": "integer"
                }
            }
        },
        "view.MMRTeamResult": {
            "type": "object",
            "required": [
                "players",
                "score"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.PlayerMMRResult"
                    }
                },
                "score": {
                    "type": "integer"
                }
            }
        },
        "view.PlayerMMRResult": {
            "type": "object",
            "required": [
                "id",
                "mmr",
                "mu",
                "sigma"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "mmr": {
                    "description": "New field in the response",
                    "type": "integer"
                },
                "mu": {
                    "description": "Required in the response",
                    "type": "number"
                },
                "sigma": {
                    "description": "Required in the response",
                    "type": "number"
                }
            }
        }
    }
}