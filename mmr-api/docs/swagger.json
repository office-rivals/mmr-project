{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "basePath": "/api",
    "paths": {
        "/v1/mmr-calculation": {
            "post": {
                "description": "Submit two teams' details for MMR calculation",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Calculation"
                ],
                "summary": "Submit an MMR calculation request",
                "parameters": [
                    {
                        "description": "MMR Calculation Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/view.MMRCalculationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MMR calculation result",
                        "schema": {
                            "$ref": "#/definitions/view.MMRCalculationResponse"
                        }
                    }
                }
            }
        },
        "/v1/mmr-calculation/batch": {
            "post": {
                "description": "Submit multiple MMR calculation requests",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Calculation"
                ],
                "summary": "Submit multiple MMR calculation requests",
                "parameters": [
                    {
                        "description": "MMR Calculation Requests",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/view.MMRCalculationRequest"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MMR calculation results",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/view.MMRCalculationResponse"
                            }
                        }
                    }
                }
            }
        },
        "/v1/mmr-calculation/predict": {
            "post": {
                "description": "Returns each team's chance of winning and each player's MMR if their team wins or loses, rated exactly as a submitted result would be",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Calculation"
                ],
                "summary": "Predict an MMR calculation before the match is played",
                "parameters": [
                    {
                        "description": "MMR Prediction Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/view.MMRPredictionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MMR prediction result",
                        "schema": {
                            "$ref": "#/definitions/view.MMRPredictionResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "view.MMRCalculationPlayerRating": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "isPreviousSeasonRating": {
                    "type": "boolean"
                },
                "mu": {
                    "description": "Use pointers to represent nullable values",
                    "type": "number"
                },
                "sigma": {
                    "description": "Use pointers to represent nullable values",
                    "type": "number"
                }
            }
        },
        "view.MMRCalculationRequest": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRCalculationTeam"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRCalculationTeam"
                }
            }
        },
        "view.MMRCalculationResponse": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRTeamResult"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRTeamResult"
                }
            }
        },
        "view.MMRCalculationTeam": {
            "type": "object",
            "required": [
                "players",
                "score"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.MMRCalculationPlayerRating"
                    }
                },
                "score": {
                    "type": "integer"
                }
            }
        },
        "view.MMRPredictionRequest": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRPredictionTeam"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRPredictionTeam"
                }
            }
        },
        "view.MMRPredictionResponse": {
            "type": "object",
            "required": [
                "team1",
                "team2"
            ],
            "properties": {
                "team1": {
                    "$ref": "#/definitions/view.MMRTeamPrediction"
                },
                "team2": {
                    "$ref": "#/definitions/view.MMRTeamPrediction"
                }
            }
        },
        "view.MMRPredictionTeam": {
            "type": "object",
            "required": [
                "players"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.MMRCalculationPlayerRating"
                    }
                }
            }
        },
        "view.MMRTeamPrediction": {
            "type": "object",
            "required": [
                "players",
                "winChance"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.PlayerMMRPrediction"
                    }
                },
                "winChance": {
                    "description": "Probability from 0 to 1; the two teams' chances sum to 1.",
                    "type": "number"
                }
            }
        },
        "view.MMRTeamResult": {
            "type": "object",
            "required": [
                "players",
                "score"
            ],
            "properties": {
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view.PlayerMMRResult"
                    }
                },
                "score": {
                    "type": "integer"
                }
            }
        },
        "view.PlayerMMRPrediction": {
            "type": "object",
            "required": [
                "id",
                "mmr",
                "mmrIfLose",
                "mmrIfWin"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "mmr": {
                    "description": "The MMR the player goes into the match with, after any season reset.",
                    "type": "integer"
                },
                "mmrIfLose": {
                    "type": "integer"
                },
                "mmrIfWin": {
                    "type": "integer"
                }
            }
        },
        "view.PlayerMMRResult": {
            "type": "object",
            "required": [
                "id",
                "mmr",
                "mu",
                "sigma"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "mmr": {
                    "description": "New field in the response",
                    "type": "integer"
                },
                "mu": {
                    "description": "Required in the response",
                    "type": "number"
                },
                "sigma": {
                    "description": "Required in the response",
                    "type": "number"
                }
            }
        }
    }
}